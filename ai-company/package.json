{
  "name": "nm-ai-company",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI社員と人間が一緒に働く、3Dバーチャルオフィス（日本・カンボジア）。裏側は Claude Code（Claude Agent SDK）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
